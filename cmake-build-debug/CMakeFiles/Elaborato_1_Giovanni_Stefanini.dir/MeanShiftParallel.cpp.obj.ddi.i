class TickMeter
{
public:

    TickMeter()
    {
        reset();
    }


    void start()
    {
        startTime = cv::getTickCount();
    }


    void stop()
    {
        const int64 time = cv::getTickCount();
        if (startTime == 0)
            return;
        ++counter;
        lastTime = time - startTime;
        sumTime += lastTime;
        startTime = 0;
    }


    int64 getTimeTicks() const
    {
        return sumTime;
    }


    double getTimeMicro() const
    {
        return getTimeMilli()*1e3;
    }


    double getTimeMilli() const
    {
        return getTimeSec()*1e3;
    }


    double getTimeSec() const
    {
        return (double)getTimeTicks() / getTickFrequency();
    }


    int64 getLastTimeTicks() const
    {
        return lastTime;
    }


    double getLastTimeMicro() const
    {
        return getLastTimeMilli()*1e3;
    }


    double getLastTimeMilli() const
    {
        return getLastTimeSec()*1e3;
    }


    double getLastTimeSec() const
    {
        return (double)getLastTimeTicks() / getTickFrequency();
    }


    int64 getCounter() const
    {
        return counter;
    }


    double getFPS() const
    {
        const double sec = getTimeSec();
        if (sec < double(2.22044604925031308084726333618164062e-16L))
            return 0.;
        return counter / sec;
    }


    double getAvgTimeSec() const
    {
        if (counter <= 0)
            return 0.;
        return getTimeSec() / counter;
    }


    double getAvgTimeMilli() const
    {
        return getAvgTimeSec() * 1e3;
    }


    void reset()
    {
        counter = 0;
        sumTime = 0;
        startTime = 0;
        lastTime = 0;
    }

private:
    int64 counter;
    int64 sumTime;
    int64 startTime;
    int64 lastTime;
};
